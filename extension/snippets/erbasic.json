{
  "if": {
    "prefix": "if",
    "body": [
      "IF ${1:condition}",
      "\t${2}",
      "ENDIF"
    ],
    "description": "IF block"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": [
      "IF ${1:condition}",
      "\t${2}",
      "ELSE",
      "\t${3}",
      "ENDIF"
    ],
    "description": "IF-ELSE block"
  },
  "ifelseif": {
    "prefix": "ifelseif",
    "body": [
      "IF ${1:condition}",
      "\t${2}",
      "ELSEIF ${3:condition}",
      "\t${4}",
      "ENDIF"
    ],
    "description": "IF-ELSEIF block"
  },
  "for": {
    "prefix": "for",
    "body": [
      "FOR ${1:i}, ${2:1}, ${3:10}${4:, ${5:1}}",
      "\t${6}",
      "NEXT"
    ],
    "description": "FOR loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "WHILE ${1:condition}",
      "\t${2}",
      "WEND"
    ],
    "description": "WHILE loop"
  },
  "repeat": {
    "prefix": "repeat",
    "body": [
      "REPEAT",
      "\t${1}",
      "REND"
    ],
    "description": "REPEAT loop"
  },
  "selectcase": {
    "prefix": "select",
    "body": [
      "SELECTCASE ${1:value}",
      "\tCASE ${2:value}",
      "\t\t${3}",
      "\tCASEELSE",
      "\t\t${4}",
      "ENDSELECT"
    ],
    "description": "SELECTCASE block"
  },
  "function": {
    "prefix": "func",
    "body": [
      "@${1:FUNCTION_NAME}(${2:params})",
      "\t${3}",
      "ENDFUNC"
    ],
    "description": "Function definition"
  },
  "function-with-return": {
    "prefix": "funcr",
    "body": [
      "#FUNCTION ${1:FUNCTION_NAME}(${2:params})",
      "\t${3}",
      "\tRETURN ${4:result}",
      "ENDFUNC"
    ],
    "description": "#FUNCTION with return"
  },
  "single-function": {
    "prefix": "sf",
    "body": [
      "#SINGLE ${1:FUNCTION_NAME}(${2:params})",
      "\t${3}",
      "ENDFUNC"
    ],
    "description": "#SINGLE function"
  },
  "dim": {
    "prefix": "dim",
    "body": [
      "#DIM ${1:VAR_NAME}${2:, ${3:size}}"
    ],
    "description": "Global integer variable"
  },
  "dims": {
    "prefix": "dims",
    "body": [
      "#DIMS ${1:VAR_NAME}${2:, ${3:size}}"
    ],
    "description": "Global string variable"
  },
  "define": {
    "prefix": "def",
    "body": [
      "#DEFINE ${1:NAME} ${2:replacement}"
    ],
    "description": "Define macro"
  },
  "call": {
    "prefix": "call",
    "body": [
      "CALL ${1:FUNCTION_NAME}(${2:args})"
    ],
    "description": "Call function"
  },
  "jump": {
    "prefix": "jump",
    "body": [
      "JUMP ${1:FUNCTION_NAME}(${2:args})"
    ],
    "description": "Tail call function"
  },
  "goto": {
    "prefix": "goto",
    "body": [
      "GOTO \$${1:LABEL}"
    ],
    "description": "Goto label"
  },
  "label": {
    "prefix": "label",
    "body": [
      "\$${1:LABEL_NAME}"
    ],
    "description": "Label definition"
  },
  "print": {
    "prefix": "print",
    "body": [
      "PRINT \"${1:message}\""
    ],
    "description": "Print without newline"
  },
  "printl": {
    "prefix": "printl",
    "body": [
      "PRINTL \"${1:message}\""
    ],
    "description": "Print with newline"
  },
  "printv": {
    "prefix": "printv",
    "body": [
      "PRINTV \"${1:prefix}\", ${2:var}${3:, ${4:var2}}"
    ],
    "description": "Print multiple values"
  },
  "printform": {
    "prefix": "printform",
    "body": [
      "PRINTFORM @\"${1:text %${2:var}%}\""
    ],
    "description": "Print FORM string"
  },
  "setcolor": {
    "prefix": "setcolor",
    "body": [
      "SETCOLOR ${1:r}, ${2:g}, ${3:b}"
    ],
    "description": "Set text color"
  },
  "wait": {
    "prefix": "wait",
    "body": [
      "WAIT ${1:frames}"
    ],
    "description": "Wait frames"
  },
  "await": {
    "prefix": "await",
    "body": [
      "AWAIT ${1:ms}"
    ],
    "description": "Await milliseconds"
  },
  "debugprint": {
    "prefix": "dbg",
    "body": [
      "DEBUGPRINT \"${1:message}\""
    ],
    "description": "Debug print"
  },
  "chara-block": {
    "prefix": "chara",
    "body": [
      "#DIM CHARA_DATA",
      "#DIM CHARA_NAME",
      "CALL SETUP_CHARA()"
    ],
    "description": "Character data setup"
  },
  "trycatch": {
    "prefix": "try",
    "body": [
      "TRYCALL ${1:FUNCTION_NAME}(${2:args})",
      "CATCH",
      "\t${3:error handling}",
      "ENDCATCH"
    ],
    "description": "Try-catch block"
  }
}